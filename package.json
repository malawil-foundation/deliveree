{
  "name": "deliveree-dispatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Deliveree dispatch console — full-stack React app with login APIs for customers, dispatchers, drivers, and admins",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "predev": "node scripts/free-ports.js 4000 5173",
    "build": "vite build",
    "start": "node server/index.js",
    "prestart": "node scripts/free-ports.js 4000",
    "preview": "vite preview",
    "server:status": "node scripts/serverctl.js status",
    "server:stop": "node scripts/serverctl.js stop",
    "server:restart": "node scripts/serverctl.js restart",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  }
}
